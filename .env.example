DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Set true only for local development to return OTP codes from the request endpoint.
OTP_EXPOSE_IN_DEBUG=false

# Configure these when connecting a real SMS or mobile-money provider.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
MOMO_PROVIDER_URL=
MOMO_PROVIDER_API_KEY=
MOMO_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret
PUBLIC_API_URL=http://127.0.0.1:8000
